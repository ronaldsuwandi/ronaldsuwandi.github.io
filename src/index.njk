---
layout: base.njk
---
    <section class="main">
        <div class="main-content">
            <img src="/img/ronald.jpg">
            <h1>{{ basic.name }}</h1>
            {{ basic.headline | paragraphSplit | safe }}
            <p class="site-links">
                {% for item in links %}<a href="{{ item.link }}"{% if item.download %} download="{{ item.download }}"{% endif %}>{{ item.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
            </p>

            <ul class="social">
                {% for item in social %}
                <a href="{{ item.link }}"{% if 'mailto:' not in item.link %} target="_blank"{% endif %} aria-label="{{ item.label }}">
                    <li>
                        <svg class="icon" aria-hidden="true"><use href="/icons.svg?v={{ '/icons.svg' | hash }}#{{ item.className }}"></use></svg>
                    </li>
                </a>
                {% endfor %}
            </ul>
            <p class="scroll-down">
                <a class="scroll-to-experiences" aria-label="Scroll down"><svg class="icon" aria-hidden="true"><use href="/icons.svg?v={{ '/icons.svg' | hash }}#icon-down-open"></use></svg></a>
            </p>
        </div>
    </section>
    <section class="featured">
        <h2>— Featured —</h2>
        <div class="cards">
            {% for entry in projects.list | selectattr("featured") | sort(false, false, "featured") %}
            <a class="card" href="{{ entry.link }}" target="_blank">
                <img src="{{ entry.icon }}" alt="">
                <strong>{{ entry.featuredTitle or entry.title }}</strong>
                <span>{{ entry.tagline }}</span>
            </a>
            {% endfor %}
        </div>
    </section>
    <section class="experiences">
            <h2>{{ experiences.title }}</h2>
            <div class="entries">
                {% for entry in experiences.list | rejectattr("earlier") %}
                <div class="entry">
                    <div class="entry-icon">
                        {% if entry.icon %}
                        <a href="{{ entry.link }}" target="_blank"><img src="{{ entry.icon }}" alt="{{ entry.iconText }}"></a>
                        {% else %}
                        <img style="visibility: hidden;">
                        {% endif %}
                    </div>
                    <div class="entry-content">
                        <div class="entry-content-title-container">
                            <p class="title"><strong>{{ entry.title }}</strong></p>
                            {% if entry.subtitle %}
                            <p class="subtitle">
                                {% if entry.link %}
                                <a href="{{ entry.link }}" target="_blank">
                                    {{ entry.subtitle }}
                                </a>
                                {% else %}
                                {{ entry.subtitle }}
                                {% endif %}
                            </p>
                            {% endif %}
                        </div>
                        <div class="entry-content-period">
                            <small>
                            {{ entry.period }}
                            {% if entry.location %}
                            <span class="entry-content-location"> | {{ entry.location }}</span>
                            {% endif %}
                          </small>
                        </div>
                        <div class="entry-content-description">
                            <ul>
                                {% for desc in entry.description %}
                                    <li>{{ desc | safe }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
            <p class="earlier">
                <strong>Earlier:</strong>
                {% for company, roles in experiences.list | selectattr("earlier") | groupby("subtitle") %}{{ company }}{% if not loop.last %} · {% endif %}{% endfor %}
                <br><a href="/cv.pdf" download="Ronald-Suwandi-CV.pdf">Download CV (PDF)</a>
            </p>
    </section>
    <section class="projects">
            <h2>{{ projects.title }}</h2>
            <div class="entries">
                {% for entry in projects.list %}
                <div class="entry">
                    <div class="entry-icon">
                        {% if entry.icon %}
                        <a href="{{ entry.link }}" target="_blank"><img src="{{ entry.icon }}" alt="{{ entry.iconText }}"></a>
                        {% else %}
                        <img style="visibility: hidden;">
                        {% endif %}
                    </div>
                    <div class="entry-content">
                        <div class="entry-content-title-container">
                            <p class="title"><strong>{{ entry.title }}</strong></p>
                            {% if entry.subtitle %}
                            <p class="subtitle">
                                {% if entry.link %}
                                <a href="{{ entry.link }}" target="_blank">{{ entry.subtitle }}</a>
                                {% else %}
                                {{ entry.subtitle }}
                                {% endif %}
                            </p>
                            {% endif %}
                        </div>
                        <div class="entry-content-period">
                            <small>
                            {{ entry.period }}
                            {% if entry.location %}
                            <span class="entry-content-location"> | {{ entry.location }}</span>
                            {% endif %}
                          </small>
                        </div>
                        <div class="entry-content-description">
                            {{ entry.description | paragraphSplit | safe }}
                            {% if entry.challenge %}<p><strong>Interesting challenge:</strong> {{ entry.challenge }}</p>{% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
    </section>
    {% if writing.list | length %}
    <section class="writing">
        <h2>{{ writing.title }}</h2>
        <ul>
            {% for item in writing.list %}
            <li><a href="{{ item.link }}" target="_blank">{{ item.title }}</a>{% if item.date %} <small>{{ item.date }}</small>{% endif %}</li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}
    <section class="educations">
            <h2>{{ educations.title }}</h2>
            <div class="entries">
                {% for entry in educations.list %}
                <div class="entry">
                    <div class="entry-icon">
                        {% if entry.icon %}
                        <a href="{{ entry.link }}" target="_blank"><img src="{{ entry.icon }}" alt="{{ entry.iconText }}"></a>
                        {% else %}
                        <img style="visibility: hidden;">
                        {% endif %}
                    </div>
                    <div class="entry-content">
                        <div class="entry-content-title-container">
                            <p class="title"><strong>{{ entry.title }}</strong></p>
                            <p class="subtitle"><a href="{{ entry.link }}" target="_blank">{{ entry.subtitle }}</a></p>
                        </div>
                        <div class="entry-content-period">
                            <small>
                            {{ entry.period }}
                            {% if entry.location %}
                            <span class="entry-content-location"> | {{ entry.location }}</span>
                            {% endif %}
                          </small>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
    </section>
    <section class="contact">
        <p class="scroll-up">
            <a class="scroll-to-main" aria-label="Scroll to top"><svg class="icon" aria-hidden="true"><use href="/icons.svg?v={{ '/icons.svg' | hash }}#icon-up-open"></use></svg></a>
        </p>
        <p class="copyright">
            &copy; Ronald Suwandi 2016<script>new Date().getFullYear()>2016&&document.write(" – "+new Date().getFullYear());</script>
        </p>
    </section>
    <script src="/js/main.js?v={{ '/js/main.js' | hash }}"></script>
